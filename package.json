{
  "name": "raft",
  "version": "0.51.0",
  "description": "A cozy, distraction-free AI coding workspace with git worktree isolation",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "test": "npm run test --workspace=server",
    "start": "npm run start --workspace=server",
    "app:dev": "node scripts/prepare-server.mjs && tauri dev",
    "app:build": "node scripts/prepare-server.mjs && tauri build",
    "app:build:linux": "node scripts/prepare-server.mjs && tauri build",
    "app:package:arch": "node scripts/package-arch.mjs",
    "tauri": "tauri",
    "build:extension": "npm run build --prefix extension",
    "test:extension": "npm test --prefix extension",
    "test:preview": "npm run test:extension && npm run test:preview --workspace=client && npm run build --workspace=server && node --test server/dist/devServerManager.test.js",
    "preview:fixture": "node scripts/preview-extension-fixture.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "concurrently": "^9.1.2"
  }
}
