{
  "manifest_version": 3,
  "name": "Alpha Bro Companion",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Capture and annotate local app previews in Alpha Bro, with improved iframe compatibility.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ],
  "icons": {
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Alpha Bro Companion",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  }
}
