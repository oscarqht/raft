{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Raft",
  "version": "0.3.0",
  "identifier": "com.oscarqht.raft",
  "build": {
    "frontendDist": "../client/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": []
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": [
      "../resources/server"
    ],
    "externalBin": [
      "bin/node"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "10.15",
      "infoPlist": "./Info.plist"
    }
  },
  "plugins": {
